{{ 'custom-homepage.css' | asset_url | stylesheet_tag }}

<section class="homepage-benefits homepage-section color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="homepage-benefits__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="homepage-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h1">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="homepage-richtext">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="homepage-benefits__grid">
      {%- for block in section.blocks -%}
        <div class="homepage-benefit" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <div class="homepage-benefit__icon" aria-hidden="true">
              <span class="svg-wrapper">
                {%- case block.settings.icon -%}
                  {%- when 'leaf' -%}
                    {{- 'icon-leaf.svg' | inline_asset_content -}}
                  {%- when 'heart' -%}
                    {{- 'icon-heart.svg' | inline_asset_content -}}
                  {%- when 'ruler' -%}
                    {{- 'icon-ruler.svg' | inline_asset_content -}}
                  {%- when 'chat' -%}
                    {{- 'icon-chat-bubble.svg' | inline_asset_content -}}
                  {%- when 'check' -%}
                    {{- 'icon-check-mark.svg' | inline_asset_content -}}
                {%- endcase -%}
              </span>
            </div>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h3 class="homepage-benefit__heading">{{ block.settings.heading | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="homepage-benefit__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial benefits",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "leaf",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "chat", "label": "Chat" },
            { "value": "check", "label": "Check" }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "CONSIDERED DESIGN"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Designed with modest dressing in mind."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "leaf",
            "heading": "CONSIDERED DESIGN",
            "text": "Designed with modest dressing in mind."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "ruler",
            "heading": "QUALITY FOCUS",
            "text": "Attention to fabric, finish and everyday wear."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "chat",
            "heading": "CUSTOMER CARE",
            "text": "Here to help throughout your shopping experience."
          }
        }
      ]
    }
  ]
}
{% endschema %}
