{{ 'custom-homepage.css' | asset_url | stylesheet_tag }}

<section class="homepage-categories homepage-section color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="homepage-categories__grid">
      {%- for block in section.blocks -%}
        <article class="homepage-category-card" {{ block.shopify_attributes }}>
          <div class="homepage-category-card__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1400
                | image_tag:
                  widths: '375, 550, 750, 990, 1200, 1400',
                  sizes: '(min-width: 750px) 50vw, 100vw',
                  loading: 'lazy',
                  alt: block.settings.image.alt,
                  style: block.settings.image_position | prepend: 'object-position: '
              }}
            {%- else -%}
              <div class="homepage-category-card__placeholder">
                {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>
          <div class="homepage-category-card__content">
            {%- if block.settings.eyebrow != blank -%}
              <p class="homepage-eyebrow">{{ block.settings.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="homepage-category-card__heading h1">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="homepage-richtext">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <a
                {% if block.settings.link != blank %}
                  href="{{ block.settings.link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
                class="homepage-category-card__link link underlined-link"
              >
                {{ block.settings.link_label | escape }}
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial categories",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image focal position",
          "default": "center center",
          "options": [
            { "value": "center center", "label": "Center" },
            { "value": "center top", "label": "Top" },
            { "value": "center bottom", "label": "Bottom" },
            { "value": "left center", "label": "Left" },
            { "value": "right center", "label": "Right" }
          ]
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "ABAYAS"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "heading": "ABAYAS"
          }
        },
        {
          "type": "category",
          "settings": {
            "heading": "HIJABS"
          }
        }
      ]
    }
  ]
}
{% endschema %}
