{{ 'custom-homepage.css' | asset_url | stylesheet_tag }}

<section class="homepage-gallery homepage-section color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="homepage-gallery__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="homepage-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h1">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="homepage-richtext">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="homepage-gallery__grid">
      {%- for block in section.blocks -%}
        {%- capture item_content -%}
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 900
              | image_tag:
                widths: '300, 450, 600, 750, 900',
                sizes: '(min-width: 750px) 25vw, 50vw',
                loading: 'lazy',
                alt: block.settings.image.alt,
                style: block.settings.image_position | prepend: 'object-position: '
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        {%- endcapture -%}

        {%- if block.settings.link != blank -%}
          <a
            href="{{ block.settings.link }}"
            class="homepage-gallery__item{% if block.settings.size == 'large' %} homepage-gallery__item--large{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{ item_content }}
          </a>
        {%- else -%}
          <div
            class="homepage-gallery__item{% if block.settings.size == 'large' %} homepage-gallery__item--large{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{ item_content }}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial gallery",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE EDIT"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image focal position",
          "default": "center center",
          "options": [
            { "value": "center center", "label": "Center" },
            { "value": "center top", "label": "Top" },
            { "value": "center bottom", "label": "Bottom" },
            { "value": "left center", "label": "Left" },
            { "value": "right center", "label": "Right" }
          ]
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "default": "standard",
          "options": [
            { "value": "standard", "label": "Standard" },
            { "value": "large", "label": "Large" }
          ]
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial gallery",
      "blocks": [
        {
          "type": "image",
          "settings": {
            "size": "large"
          }
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
